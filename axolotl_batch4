#!/bin/bash
#SBATCH --job-name=batch4_axolotl
#SBATCH --output='%x-%j.out'
#SBATCH --time=00:02:00
#SBATCH --nodes=1
#SBATCH --ntasks=2
#SBATCH --gres=gpu:2
#SBATCH --mem=2G
#SBATCH -p cscc-gpu-p
#SBATCH -q cscc-gpu-qos

export HF_HOME=/l/users/ryandito.diandaru/huggingface
export HF_HUB_CACHE=/l/users/ryandito.diandaru/huggingface/hub
export TRANSFORMERS_CACHE=/l/users/ryandito.diandaru/huggingface/transformers

echo "Starting NVIDIA SMI..."
nvidia-smi

# log the sbatch environment
echo "start time: $(date)"
echo "SLURM_JOBID="$SLURM_JOBID
echo "SLURM_JOB_NODELIST"=$SLURM_JOB_NODELIST
echo "SLURM_JOB_PARTITION"=$SLURM_JOB_PARTITION
echo "SLURM_NNODES"=$SLURM_NNODES
echo "SLURM_GPUS_ON_NODE"=$SLURM_GPUS_ON_NODE
echo "SLURM_SUBMIT_DIR"=$SLURM_SUBMIT_DIR

MASTER_ADDR=$(scontrol show hostnames $SLURM_JOB_NODELIST | head -n 1)
echo "MASTER_ADDR"=$MASTER_ADDR

# https://github.com/huggingface/accelerate/issues/1519
# https://github.com/huggingface/accelerate/issues/1645
accelerate launch \
  lmh_test.py \
  --run_name 'llama32_1B_Inst-question2_6' \
  --model_string 'meta-llama/Llama-3.2-1B-Instruct' \
  --question_document_index 2_6

